# Application Settings
APP_NAME=vision-api
APP_VERSION=0.1.0
DEBUG=true

# Security & CORS (Comma-separated list or JSON array of origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
SECRET_KEY=dev-insecure-secret-key-change-in-production-only-placeholder-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting (slowapi)
LOGIN_RATE_LIMIT=5/minute
RATE_LIMIT_ENABLED=true

# Database (SQLite default for hackathon simplicity)
DATABASE_URL=sqlite:///./vision_api.db

# Detector Configuration
DETECTOR_BACKEND=dummy
MODEL_PATH=models_store/yolov8n.pt
CONFIDENCE_THRESHOLD=0.25
MAX_UPLOAD_MB=10
MAX_IMAGE_DIMENSION=6000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=uploads

# Video & Background Job Configuration
MAX_VIDEO_UPLOAD_MB=100
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime,video/x-msvideo
FRAME_SKIP=5
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_USER=3
FRAME_READER_BACKEND=dummy
DUMMY_FRAME_DELAY_MS=20
JOB_RUNNER_INLINE=false

# Alert, Analytics & WebSocket Configuration
ALERT_WARNING_THRESHOLD=10
ALERT_CRITICAL_THRESHOLD=20
ALERT_COOLDOWN_SECONDS=30
WS_AUTH_TIMEOUT_SECONDS=5
WS_MAX_FRAME_KB=2048
WS_MAX_CONNECTIONS_PER_USER=3
ANALYTICS_MAX_ROWS=5000
ANALYTICS_MAX_RANGE_DAYS=90

# Hardening, Rate Limiting & Inference Protection (Step 7)
LOG_LEVEL=INFO
MAX_REQUEST_BODY_KB=1024
DEFAULT_RATE_LIMIT=120/minute
UPLOAD_RATE_LIMIT=20/minute
REFRESH_RATE_LIMIT=10/minute
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_WORKERS=2
INFERENCE_QUEUE_LIMIT=8
MAX_FRAME_FAILURE_RATIO=0.5
ENABLE_DOCS=true
SECURITY_HEADERS_ENABLED=true
